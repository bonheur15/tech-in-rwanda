---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCommunity from '../../components/ArticleCommunity';
import RichText from '../../components/RichText.astro';
const origin = process.env.INTERNAL_API_URL ?? import.meta.env.INTERNAL_API_URL ?? Astro.url.origin;
const response = await fetch(
  `${origin}/api/v1/public/posts/${encodeURIComponent(Astro.params.slug ?? '')}`,
);
if (response.status === 404) return Astro.redirect('/404');
const payload = await response.json();
const post = payload.data;
const blocks = Array.isArray(post?.content?.content) ? post.content.content : [];
const collectText = (node: any): string =>
  `${node?.text ?? ''} ${(node?.content ?? []).map(collectText).join(' ')}`;
const words = collectText(post?.content ?? {})
  .trim()
  .split(/\s+/)
  .filter(Boolean).length;
const readTime = Math.max(1, Math.ceil(words / 220));
---

<BaseLayout
  title={`${post.title} | Rwanda Free Space`}
  description={post.excerpt}
  canonical={new URL(`/critiques/${post.slug}/`, Astro.url.origin).toString()}
  image={post.thumbnail ?? '/default-thumbnail.svg'}
  type="article"
>
  <main
    id="main-content"
    class="mx-auto max-w-[82rem] px-[clamp(1.25rem,5vw,5rem)] py-[clamp(4rem,8vw,8rem)]"
  >
    <a href="/critiques/" class="text-sm text-muted">← All critiques</a>
    <header
      class="mx-auto mt-16 max-w-4xl border-b border-line pb-12 text-center"
    >
      {
        post.sourceSlug && (
          <p class="mb-4 text-xs font-bold uppercase tracking-widest text-accent">
            Forked from <a class="underline" href={`/critiques/${post.sourceSlug}/`}>an earlier critique</a>
          </p>
        )
      }
      <h1
        class="font-display text-[clamp(3rem,6vw,6.2rem)] leading-[.98] tracking-[-.055em] text-pretty"
      >
        {post.title}
      </h1>
      <p class="mx-auto mt-7 max-w-2xl text-lg leading-relaxed text-muted">
        {post.excerpt}
      </p>
      <p class="mt-8 text-xs uppercase tracking-widest text-muted">
        By <a class="underline" href={`/authors/${post.authorHandle}/`}>{post.author}</a> · {readTime} min read · {
          post.publishedAt &&
            new Date(post.publishedAt).toLocaleDateString("en-RW", {
              dateStyle: "long",
              timeZone: "Africa/Kigali",
            })
        }
      </p>
      {(Boolean(post.category) || post.tags?.length > 0) && <nav class="mt-5 flex flex-wrap justify-center gap-3 text-xs font-semibold uppercase tracking-wider">
        {post.category && <a href={`/categories/${post.categorySlug}/`} class="border border-line px-3 py-1.5">{post.category}</a>}
        {post.tags?.map((tag: any) => <a href={`/tags/${tag.slug}/`} class="border border-line px-3 py-1.5">#{tag.name}</a>)}
      </nav>}
    </header>
    <article class="article-body mx-auto mt-16 max-w-3xl">
      {
        blocks.map((block: any) => <RichText node={block} />)
      }
    </article>
    <ArticleCommunity postId={post.id} client:load />
  </main>
</BaseLayout>
