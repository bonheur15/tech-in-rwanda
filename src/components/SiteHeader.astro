<header
  class="mx-auto grid min-h-24 w-full max-w-[90rem] grid-cols-[1fr_auto_1fr] items-center border-b border-line px-[clamp(1.25rem,4vw,4.5rem)] max-md:grid-cols-[1fr_auto] max-sm:min-h-20"
>
  <a
    class="flex w-fit items-center gap-3 text-sm font-bold tracking-[-0.02em] text-ink no-underline"
    href="/"
    aria-label="Rwanda Free Space home"
  >
    <img
      class="block size-[2.35rem]"
      src="/logo.svg"
      width="48"
      height="48"
      alt=""
    />
    <span class="max-sm:hidden">Rwanda Free Space</span>
  </a>

  <nav
    class="flex gap-[clamp(1.25rem,3vw,2.75rem)] max-md:hidden"
    aria-label="Primary navigation"
  >
    <a
      class="text-[0.82rem] font-semibold text-muted no-underline hover:text-accent"
      href="/critiques/">Critiques</a
    >
    <a
      class="text-[0.82rem] font-semibold text-muted no-underline hover:text-accent"
      href="/subjects/">Subjects</a
    >
    <a
      class="text-[0.82rem] font-semibold text-muted no-underline hover:text-accent"
      href="/#about">Purpose</a
    >
  </nav>

  <a
    class="flex w-fit items-center justify-self-end gap-2 border-b border-ink py-1.5 text-[0.82rem] font-semibold no-underline"
    href="mailto:hello@rwandafreespace.com?subject=Send%20me%20new%20critiques"
  >
    Get new critiques
    <svg
      class="size-4 fill-none stroke-current [stroke-linecap:round] [stroke-linejoin:round]"
      viewBox="0 0 16 16"
      aria-hidden="true"
    >
      <path d="M3 8h10M9 4l4 4-4 4"></path>
    </svg>
  </a>
