# Used by Astro only during local development. Production uses the same origin.
INTERNAL_API_URL=http://127.0.0.1:8787

# Go server settings.
APP_ADDR=127.0.0.1:8787
APP_ALLOWED_ORIGINS=http://localhost:4321,http://127.0.0.1:4321
PUBLIC_ORIGIN=http://127.0.0.1:4321
DATABASE_PATH=.data/blog.sqlite3
MEDIA_DIR=.data/media
UPLOAD_TEMP_DIR=.data/tmp
APP_ENV=development
SESSION_PEPPER=replace-with-at-least-32-random-characters
OTP_PEPPER=replace-with-another-32-random-characters
MAIL_MODE=terminal
SMTP_ADDRESS=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
