---
import "../styles/global.css";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";

const stories = [
  {
    category: "UX teardown",
    title: "What a broken public-service form teaches us about usable design",
    summary:
      "The confusing fields, missing feedback, and dead ends that make a simple online task harder, plus a practical way to rebuild it.",
    date: "30 August 2026",
    datetime: "2026-08-30",
    readTime: "6 min read",
    tone: "red",
  },
  {
    category: "Product critique",
    title: "A checkout that asks too much and explains too little",
    summary:
      "We trace where trust disappears in a local shopping flow and show the smaller decisions that would make it feel reliable.",
    date: "28 August 2026",
    datetime: "2026-08-28",
    readTime: "5 min read",
    tone: "ink",
  },
  {
    category: "Accessibility",
    title: "The Rwandan websites that forget keyboard users",
    summary:
      "A plain-language look at invisible focus, unreachable menus, and fixes that improve the experience for everyone.",
    date: "25 August 2026",
    datetime: "2026-08-25",
    readTime: "7 min read",
    tone: "sand",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Constructive critiques of broken websites, products, and digital experiences in Rwanda, with practical ideas for fixing them."
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>Rwanda Free Space | Honest critiques of local digital products</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <SiteHeader />

    <main id="main-content">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow">An independent space for Rwandan tech criticism</p>
          <h1 id="hero-title">Good technology starts with honest criticism.</h1>
          <p class="hero-intro">
            We document broken websites, frustrating products, and weak design decisions in Rwanda, then
            explain what went wrong and how they could be better.
          </p>
          <a class="primary-link" href="#stories">
            Read the latest critiques
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" />
            </svg>
          </a>
        </div>

        <div class="hero-art" aria-hidden="true">
          <span class="art-label">RFS / 250</span>
          <svg viewBox="0 0 520 430" role="presentation">
            <circle class="art-sun" cx="363" cy="101" r="39" />
            <path
              class="art-rays"
              d="M363 40v-20M363 182v-20M302 101h-20M444 101h-20M320 58l-14-14M420 158l-14-14M320 144l-14 14M420 44l-14 14"
            />
            <path class="art-land" d="M0 319c73-33 130-16 189-58 68-48 113-120 190-106 67 12 86 83 141 96v179H0Z" />
            <path class="art-line" d="M-16 330c98-44 152-13 221-72 54-47 107-124 185-100 47 14 72 75 146 101" />
          </svg>
          <p>Find the friction.<br />Explain the fix.</p>
        </div>
      </section>

      <section class="stories" id="stories" aria-labelledby="stories-title">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Observed, tested, explained</p>
            <h2 id="stories-title">Latest critiques</h2>
          </div>
          <a href="/critiques/test-article/">Open test article</a>
        </div>

        <div class="story-grid">
          {stories.map((story, index) => (
            <article class="story-card">
              <a href="/critiques/test-article/" aria-label={`Read: ${story.title}`}>
                <div class:list={["story-visual", `tone-${story.tone}`]}>
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  <svg viewBox="0 0 320 190" aria-hidden="true">
                    <path d="M-20 151c45-28 81-26 121-4 46 25 80 19 118-30 28-36 63-50 121-29" />
                    <circle cx={index === 1 ? 220 : 238} cy={index === 2 ? 70 : 54} r="28" />
                  </svg>
                </div>
                <p class="story-category">{story.category}</p>
                <h3>{story.title}</h3>
                <p class="story-summary">{story.summary}</p>
                <p class="story-meta">
                  <time datetime={story.datetime}>{story.date}</time>
                  <span aria-hidden="true">·</span>
                  <span>{story.readTime}</span>
                </p>
              </a>
            </article>
          ))}
        </div>
      </section>

      <section class="topics" id="topics" aria-labelledby="topics-title">
        <div>
          <p class="eyebrow">What we examine</p>
          <h2 id="topics-title">Criticism that points<br />toward a better product.</h2>
        </div>
        <ul>
          <li><a href="#websites"><span>01</span>Websites &amp; online forms</a></li>
          <li><a href="#products"><span>02</span>Apps &amp; digital products</a></li>
          <li><a href="#accessibility"><span>03</span>Accessibility &amp; inclusion</a></li>
          <li><a href="#public-tech"><span>04</span>Public digital services</a></li>
        </ul>
      </section>

      <section class="about" id="about" aria-labelledby="about-title">
        <p class="eyebrow">Why this blog exists</p>
        <h2 id="about-title">Critique the work, improve the standard.</h2>
        <p>
          Rwanda Free Space independently documents where local digital experiences fail the people using
          them. The goal is not ridicule. Each critique identifies the problem, explains its impact, and
          offers a realistic path toward a clearer, more accessible, and more trustworthy product.
        </p>
      </section>
    </main>

    <SiteFooter />
  </body>
</html>
