---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StoryList from '../../components/StoryList.astro';
const slug = Astro.params.slug ?? '';
const origin = process.env.INTERNAL_API_URL ?? import.meta.env.INTERNAL_API_URL ?? Astro.url.origin;
const [categoriesResponse, postsResponse] = await Promise.all([
  fetch(`${origin}/api/v1/categories`),
  fetch(`${origin}/api/v1/public/posts?category=${encodeURIComponent(slug)}`),
]);
const categories = categoriesResponse.ok ? (await categoriesResponse.json()).data : [];
const category = categories.find((x: any) => x.slug === slug);
if (!category) return Astro.redirect('/404');
const posts = postsResponse.ok ? (await postsResponse.json()).data : [];
---
<BaseLayout title={`${category.name} | Rwanda Free Space`} description={category.description}><main id="main-content" class="mx-auto max-w-[90rem] px-[clamp(1.25rem,4vw,4.5rem)] py-[clamp(4rem,8vw,8rem)]"><StoryList eyebrow="Category" title={category.name} description={category.description} posts={posts}/></main></BaseLayout>
