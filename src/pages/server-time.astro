---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="A live test of the generated Rwanda Free Space TypeScript client and Go API." />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>Go API client test | Rwanda Free Space</title>
  </head>
  <body>
    <a class="fixed top-3 left-3 z-50 -translate-y-[160%] bg-ink px-4 py-2.5 text-canvas focus:translate-y-0" href="#main-content">Skip to API test</a>
    <SiteHeader />

    <main class="mx-auto w-full max-w-[90rem] px-[clamp(1.25rem,4vw,4.5rem)] py-[clamp(3rem,7vw,7rem)]" id="main-content">
      <section class="grid grid-cols-[minmax(0,1.08fr)_minmax(19rem,.72fr)] overflow-hidden border border-line max-[850px]:grid-cols-1" aria-labelledby="api-test-title">
        <div class="bg-surface p-[clamp(2rem,6vw,6rem)]">
          <p class="mb-5 text-[0.72rem] font-bold uppercase tracking-[0.14em] text-accent">Go API · Generated TypeScript client</p>
          <h1 class="mb-6 max-w-[12ch] font-display text-[clamp(3rem,6vw,5.5rem)] leading-[0.96] font-medium tracking-[-0.055em] text-pretty" id="api-test-title">One contract, from Go to the browser.</h1>
          <p class="max-w-[42rem] text-[clamp(1rem,1.35vw,1.2rem)] leading-[1.7] text-muted">
            This page is static Astro. Its data comes from the Go API through a generated, typed client with
            request timeout, in-flight deduplication, and a five-second memory cache.
          </p>

          <div class="mt-10 flex flex-wrap gap-3">
            <button class="cursor-pointer border border-ink bg-ink px-5 py-3 text-sm font-bold text-canvas hover:bg-accent" id="cached-request" type="button">
              Request with cache
            </button>
            <button class="cursor-pointer border border-ink bg-transparent px-5 py-3 text-sm font-bold text-ink hover:border-accent hover:text-accent" id="fresh-request" type="button">
              Force fresh request
            </button>
          </div>
        </div>

        <div class="relative flex min-h-[32rem] flex-col justify-between overflow-hidden bg-accent p-[clamp(2rem,4vw,4rem)] text-[#fffaf4] max-[850px]:min-h-[27rem]" aria-live="polite" aria-atomic="true">
          <span class="pointer-events-none absolute inset-0 bg-[radial-gradient(rgba(255,255,255,.16)_0.7px,transparent_0.7px)] bg-[length:5px_5px] opacity-30"></span>
          <div class="relative z-10 flex items-center justify-between gap-4 text-[0.68rem] font-bold uppercase tracking-[0.12em]">
            <span>API / v1</span>
            <span class="rounded-full border border-current px-3 py-1.5" id="request-state">Connecting</span>
          </div>

          <div class="relative z-10">
            <p class="mb-3 text-[0.68rem] font-bold uppercase tracking-[0.12em] text-[#ffd8d3]">Current server time in Kigali</p>
            <time class="block max-w-[13ch] font-display text-[clamp(2.3rem,4vw,4rem)] leading-[1.02] tracking-[-0.04em]" id="server-time">Waiting for the Go API</time>
          </div>

          <dl class="relative z-10 grid grid-cols-2 gap-x-5 gap-y-4 border-t border-white/35 pt-5 text-xs">
            <div>
              <dt class="mb-1 text-[#ffd8d3]">Client source</dt>
              <dd class="m-0 font-bold" id="cache-source">Not loaded</dd>
            </div>
            <div>
              <dt class="mb-1 text-[#ffd8d3]">Request ID</dt>
              <dd class="m-0 truncate font-mono font-bold" id="request-id">Not loaded</dd>
            </div>
            <div class="col-span-2">
              <dt class="mb-1 text-[#ffd8d3]">API endpoint</dt>
              <dd class="m-0 font-mono font-bold">/api/v1/server-time</dd>
            </div>
          </dl>
        </div>
      </section>

      <section class="grid grid-cols-3 border-x border-b border-line max-md:grid-cols-1" aria-label="Client capabilities">
        {
          [
            ["01", "Typed contract", "The response types and API function are generated from the Go-owned contract."],
            ["02", "Smart cache", "Normal calls reuse fresh data for five seconds and merge identical requests already in flight."],
            ["03", "Safe failure", "Every request has a timeout, response validation, and structured errors for the interface."],
          ].map(([number, title, copy]) => (
            <article class="border-r border-line p-7 last:border-r-0 max-md:border-r-0 max-md:border-b max-md:last:border-b-0">
              <p class="mb-8 text-[0.68rem] font-bold text-accent">{number}</p>
              <h2 class="mb-2 font-display text-2xl font-medium">{title}</h2>
              <p class="m-0 text-sm leading-relaxed text-muted">{copy}</p>
            </article>
          ))
        }
      </section>
    </main>

    <SiteFooter />

    <script>
      import { APIRequestError, getServerTime } from "../lib/api/generated";

      const time = document.querySelector<HTMLTimeElement>("#server-time");
      const state = document.querySelector<HTMLElement>("#request-state");
      const source = document.querySelector<HTMLElement>("#cache-source");
      const requestID = document.querySelector<HTMLElement>("#request-id");
      const cachedButton = document.querySelector<HTMLButtonElement>("#cached-request");
      const freshButton = document.querySelector<HTMLButtonElement>("#fresh-request");

      async function loadServerTime(forceRefresh = false) {
        if (!time || !state || !source || !requestID || !cachedButton || !freshButton) return;

        state.textContent = "Loading";
        cachedButton.disabled = true;
        freshButton.disabled = true;

        try {
          const result = await getServerTime({ forceRefresh });
          time.textContent = result.data.display;
          time.dateTime = result.data.iso;
          state.textContent = "Connected";
          source.textContent = result.client.source;
          requestID.textContent = result.meta.requestId;
          requestID.title = result.meta.requestId;
        } catch (error) {
          const message = error instanceof APIRequestError ? error.message : "Unable to reach the Go API";
          time.textContent = message;
          state.textContent = "Unavailable";
          source.textContent = "error";
          requestID.textContent = error instanceof APIRequestError ? error.requestId ?? "No request ID" : "No request ID";
        } finally {
          cachedButton.disabled = false;
          freshButton.disabled = false;
        }
      }

      cachedButton?.addEventListener("click", () => void loadServerTime());
      freshButton?.addEventListener("click", () => void loadServerTime(true));
      void loadServerTime();
    </script>
  </body>
</html>
