---
interface Props {
  node: any;
}
const { node } = Astro.props;
const children = Array.isArray(node?.content) ? node.content : [];
const text = node?.text ?? '';
const marks = Array.isArray(node?.marks) ? node.marks : [];
const link = marks.find((mark: any) => mark.type === 'link');
const safeHref =
  typeof link?.attrs?.href === 'string' && /^(https?:|mailto:|\/|#)/.test(link.attrs.href)
    ? link.attrs.href
    : null;
const placement = ['small', 'center', 'wide', 'full', 'left', 'right'].includes(
  node?.attrs?.placement,
)
  ? node.attrs.placement
  : 'center';
const widthMax = placement === 'left' || placement === 'right' ? 60 : 100;
const width = Math.max(30, Math.min(widthMax, Number(node?.attrs?.width) || 100));
const crop = ['original', '16:9', '4:3', '1:1'].includes(node?.attrs?.cropAspect)
  ? node.attrs.cropAspect
  : 'original';
const focalX = Math.max(0, Math.min(1, Number(node?.attrs?.focalX) || 0.5)) * 100;
const focalY = Math.max(0, Math.min(1, Number(node?.attrs?.focalY) || 0.5)) * 100;
---
{node?.type === 'text' ? (
  link && safeHref ? <a href={safeHref} rel={safeHref.startsWith('http') ? 'noopener noreferrer' : undefined}>{text}</a> : marks.some((mark: any) => mark.type === 'bold') ? <strong>{text}</strong> : marks.some((mark: any) => mark.type === 'italic') ? <em>{text}</em> : marks.some((mark: any) => mark.type === 'strike') ? <s>{text}</s> : marks.some((mark: any) => mark.type === 'code') ? <code>{text}</code> : text
) : node?.type === 'paragraph' ? <p>{children.map((child: any) => <Astro.self node={child}/>)}</p>
  : node?.type === 'heading' && node?.attrs?.level === 3 ? <h3>{children.map((child: any) => <Astro.self node={child}/>)}</h3>
  : node?.type === 'heading' ? <h2>{children.map((child: any) => <Astro.self node={child}/>)}</h2>
  : node?.type === 'blockquote' ? <blockquote>{children.map((child: any) => <Astro.self node={child}/>)}</blockquote>
  : node?.type === 'bulletList' ? <ul>{children.map((child: any) => <Astro.self node={child}/>)}</ul>
  : node?.type === 'orderedList' ? <ol>{children.map((child: any) => <Astro.self node={child}/>)}</ol>
  : node?.type === 'listItem' ? <li>{children.map((child: any) => <Astro.self node={child}/>)}</li>
  : node?.type === 'codeBlock' ? <pre><code>{children.map((child: any) => child.text ?? '')}</code></pre>
  : node?.type === 'horizontalRule' ? <hr/>
  : node?.type === 'image' ? <figure class:list={['rich-image',`rich-image-${placement}`]} style={`--image-width:${width}%;--focal-x:${focalX}%;--focal-y:${focalY}%`}><div class:list={['rich-image-crop',`crop-${crop.replace(':','-')}`]}><img src={node.attrs?.src} alt={node.attrs?.alt ?? ''}/></div>{(node.attrs?.caption || node.attrs?.credit) && <figcaption>{node.attrs?.caption}{node.attrs?.caption && node.attrs?.credit && ' · '}{node.attrs?.credit}</figcaption>}</figure>
  : children.map((child: any) => <Astro.self node={child}/>)}
