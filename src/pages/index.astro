---
import "../styles/global.css";

const stories = [
  {
    category: "Startups",
    title: "The founders building Rwanda’s next generation of digital services",
    summary:
      "A closer look at the small teams turning local problems into focused, useful technology.",
    date: "30 August 2026",
    readTime: "6 min read",
    tone: "red",
  },
  {
    category: "Infrastructure",
    title: "What better connectivity means beyond Kigali",
    summary:
      "New access is changing how businesses work, students learn, and communities share information.",
    date: "28 August 2026",
    readTime: "5 min read",
    tone: "ink",
  },
  {
    category: "People",
    title: "Inside a growing community of Rwandan software makers",
    summary:
      "Meet the developers creating tools, teaching peers, and shaping a more connected ecosystem.",
    date: "25 August 2026",
    readTime: "7 min read",
    tone: "sand",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Independent stories about technology, builders, and digital progress in Rwanda."
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>Tech in Rwanda — Ideas, builders, and progress</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <header class="site-header">
      <a class="brand" href="/" aria-label="Tech in Rwanda home">
        <span class="brand-mark" aria-hidden="true">TR</span>
        <span>Tech in Rwanda</span>
      </a>

      <nav aria-label="Primary navigation">
        <a href="#stories">Stories</a>
        <a href="#topics">Topics</a>
        <a href="#about">About</a>
      </nav>

      <a class="subscribe-link" href="mailto:hello@techinrwanda.com?subject=Newsletter%20signup">
        Subscribe
        <svg viewBox="0 0 16 16" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" />
        </svg>
      </a>
    </header>

    <main id="main-content">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow">Independent technology journal</p>
          <h1 id="hero-title">The people shaping Rwanda’s digital future.</h1>
          <p class="hero-intro">
            Thoughtful reporting on the builders, ideas, and systems moving Rwanda’s technology
            ecosystem forward.
          </p>
          <a class="primary-link" href="#stories">
            Read the latest stories
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" />
            </svg>
          </a>
        </div>

        <div class="hero-art" aria-hidden="true">
          <span class="art-label">RW / 250</span>
          <svg viewBox="0 0 520 430" role="presentation">
            <path class="art-land" d="M0 319c73-33 130-16 189-58 68-48 113-120 190-106 67 12 86 83 141 96v179H0Z" />
            <path class="art-line" d="M-16 330c98-44 152-13 221-72 54-47 107-124 185-100 47 14 72 75 146 101" />
            <circle cx="363" cy="129" r="57" />
            <path class="art-grid" d="M363 53v152M287 129h152M310 76l107 107M310 183 417 76" />
          </svg>
          <p>Ideas rooted here.<br />Built for everywhere.</p>
        </div>
      </section>

      <section class="stories" id="stories" aria-labelledby="stories-title">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Fresh perspectives</p>
            <h2 id="stories-title">Latest stories</h2>
          </div>
          <a href="#all-stories">View all stories</a>
        </div>

        <div class="story-grid">
          {stories.map((story, index) => (
            <article class="story-card">
              <a href={`#story-${index + 1}`} aria-label={`Read: ${story.title}`}>
                <div class:list={["story-visual", `tone-${story.tone}`]}>
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  <svg viewBox="0 0 320 190" aria-hidden="true">
                    <path d="M-20 151c45-28 81-26 121-4 46 25 80 19 118-30 28-36 63-50 121-29" />
                    <circle cx={index === 1 ? 220 : 238} cy={index === 2 ? 70 : 54} r="28" />
                  </svg>
                </div>
                <p class="story-category">{story.category}</p>
                <h3>{story.title}</h3>
                <p class="story-summary">{story.summary}</p>
                <p class="story-meta">
                  <time datetime="2026-08-30">{story.date}</time>
                  <span aria-hidden="true">·</span>
                  <span>{story.readTime}</span>
                </p>
              </a>
            </article>
          ))}
        </div>
      </section>

      <section class="topics" id="topics" aria-labelledby="topics-title">
        <div>
          <p class="eyebrow">Explore the ecosystem</p>
          <h2 id="topics-title">Stories with context,<br />not just headlines.</h2>
        </div>
        <ul>
          <li><a href="#startups"><span>01</span>Startups &amp; business</a></li>
          <li><a href="#policy"><span>02</span>Policy &amp; infrastructure</a></li>
          <li><a href="#people"><span>03</span>People &amp; community</a></li>
          <li><a href="#research"><span>04</span>Research &amp; ideas</a></li>
        </ul>
      </section>

      <section class="about" id="about" aria-labelledby="about-title">
        <p class="eyebrow">About the journal</p>
        <h2 id="about-title">Technology deserves local perspective.</h2>
        <p>
          Tech in Rwanda is an independent publication documenting the work, questions, and people
          behind the country’s technology ecosystem. We value useful reporting over noise.
        </p>
      </section>
    </main>

    <footer>
      <a class="brand footer-brand" href="/">
        <span class="brand-mark" aria-hidden="true">TR</span>
        <span>Tech in Rwanda</span>
      </a>
      <p>Independent stories on technology in Rwanda.</p>
      <p>© 2026 Tech in Rwanda</p>
    </footer>
  </body>
</html>
