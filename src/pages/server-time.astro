---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import "../styles/global.css";

export const prerender = false;

const generatedAt = new Date();
const serverTime = new Intl.DateTimeFormat("en-RW", {
  dateStyle: "full",
  timeStyle: "long",
  timeZone: "Africa/Kigali",
}).format(generatedAt);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="A live test of server-side rendering on Rwanda Free Space." />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>Server time test | Rwanda Free Space</title>
  </head>
  <body>
    <a class="fixed top-3 left-3 z-50 -translate-y-[160%] bg-ink px-4 py-2.5 text-canvas focus:translate-y-0" href="#main-content">Skip to server result</a>
    <SiteHeader />

    <main class="mx-auto grid min-h-[calc(100vh-12rem)] w-full max-w-[90rem] place-items-center px-[clamp(1.25rem,4vw,4.5rem)] py-16" id="main-content">
      <section class="w-full max-w-3xl border border-line bg-surface p-[clamp(2rem,6vw,5rem)]" aria-labelledby="server-time-title">
        <p class="mb-5 text-[0.72rem] font-bold uppercase tracking-[0.14em] text-accent">Live Node server check</p>
        <h1 class="mb-6 font-display text-[clamp(2.75rem,7vw,5.25rem)] leading-[0.98] font-medium tracking-[-0.05em]" id="server-time-title">This page ran on the server.</h1>
        <p class="mb-3 text-sm font-bold uppercase tracking-[0.1em] text-muted">Current server time in Kigali</p>
        <time class="block border-y border-line py-6 font-display text-[clamp(1.6rem,4vw,2.65rem)] leading-tight" datetime={generatedAt.toISOString()}>{serverTime}</time>
        <p class="mt-6 max-w-xl text-sm leading-relaxed text-muted">
          Refresh this page. If the time changes, Node generated a fresh response for your request.
        </p>
        <a class="mt-8 inline-flex items-center gap-2 border-b border-accent py-2 text-sm font-bold text-accent-dark no-underline" href="/server-time/">
          Refresh server time <span aria-hidden="true">↻</span>
        </a>
      </section>
    </main>

    <SiteFooter />
  </body>
</html>
