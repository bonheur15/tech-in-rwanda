---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StoryList from '../../components/StoryList.astro';
const slug = Astro.params.slug ?? '';
const origin = process.env.INTERNAL_API_URL ?? import.meta.env.INTERNAL_API_URL ?? Astro.url.origin;
const response = await fetch(`${origin}/api/v1/public/posts?tag=${encodeURIComponent(slug)}`);
const posts = response.ok ? (await response.json()).data : [];
---
<BaseLayout title={`#${slug} | Rwanda Free Space`}><main id="main-content" class="mx-auto max-w-[90rem] px-[clamp(1.25rem,4vw,4.5rem)] py-[clamp(4rem,8vw,8rem)]"><StoryList eyebrow="Tag" title={`#${slug}`} posts={posts}/></main></BaseLayout>
