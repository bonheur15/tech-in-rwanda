---
interface Props {
  node: any;
}
const { node } = Astro.props;
const children = Array.isArray(node?.content) ? node.content : [];
const text = node?.text ?? '';
const marks = Array.isArray(node?.marks) ? node.marks : [];
const link = marks.find((mark: any) => mark.type === 'link');
const safeHref =
  typeof link?.attrs?.href === 'string' && /^(https?:|mailto:|\/|#)/.test(link.attrs.href)
    ? link.attrs.href
    : null;
const placement = ['center', 'wide', 'full', 'left', 'right'].includes(node?.attrs?.placement)
  ? node.attrs.placement
  : 'center';
---
{node?.type === 'text' ? (
  link && safeHref ? <a href={safeHref} rel={safeHref.startsWith('http') ? 'noopener noreferrer' : undefined}>{text}</a> : marks.some((mark: any) => mark.type === 'bold') ? <strong>{text}</strong> : marks.some((mark: any) => mark.type === 'italic') ? <em>{text}</em> : marks.some((mark: any) => mark.type === 'code') ? <code>{text}</code> : text
) : node?.type === 'paragraph' ? <p>{children.map((child: any) => <Astro.self node={child}/>)}</p>
  : node?.type === 'heading' && node?.attrs?.level === 3 ? <h3>{children.map((child: any) => <Astro.self node={child}/>)}</h3>
  : node?.type === 'heading' ? <h2>{children.map((child: any) => <Astro.self node={child}/>)}</h2>
  : node?.type === 'blockquote' ? <blockquote>{children.map((child: any) => <Astro.self node={child}/>)}</blockquote>
  : node?.type === 'bulletList' ? <ul>{children.map((child: any) => <Astro.self node={child}/>)}</ul>
  : node?.type === 'orderedList' ? <ol>{children.map((child: any) => <Astro.self node={child}/>)}</ol>
  : node?.type === 'listItem' ? <li>{children.map((child: any) => <Astro.self node={child}/>)}</li>
  : node?.type === 'codeBlock' ? <pre><code>{children.map((child: any) => child.text ?? '')}</code></pre>
  : node?.type === 'horizontalRule' ? <hr/>
  : node?.type === 'image' ? <figure class:list={[placement === 'wide' && 'md:-mx-24', placement === 'full' && 'md:-mx-48', placement === 'left' && 'md:float-left md:mr-8 md:w-1/2', placement === 'right' && 'md:float-right md:ml-8 md:w-1/2']}><img src={node.attrs?.src} alt={node.attrs?.alt ?? ''}/>{node.attrs?.caption && <figcaption>{node.attrs.caption}{node.attrs?.credit && ` · ${node.attrs.credit}`}</figcaption>}</figure>
  : children.map((child: any) => <Astro.self node={child}/>)}
